# Python version decided in docs/decisions/ADR-001-python-version.md
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# No system GDAL or compiler: rasterio, fiona, pyogrio, shapely and pyproj ship
# manylinux wheels with their own GDAL/GEOS/PROJ, and those bundled copies are
# the ones loaded (verified with ldd). --only-binary makes a missing wheel fail
# the build loudly instead of silently compiling against something else.
# Geometry repair needs GEOS >= 3.10: app/shared/geo.py refuses to start below.

# The one system library the wheels do not bundle: GDAL inside the rasterio
# and fiona wheels links against libexpat. It used to arrive with gdal-bin;
# without it `import rasterio` fails (found when the worker first imported it).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir --only-binary=:all: \
    -r requirements.txt -r requirements-dev.txt

COPY backend ./backend

# Run as an unprivileged user.
# /app/data exists before the volume is mounted so the volume inherits the
# app user's ownership; otherwise the worker could not write rasters.
RUN mkdir -p /app/data/rasters \
    && useradd --create-home --uid 10001 app \
    && chown -R app:app /app
USER app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--app-dir", "backend", "--host", "0.0.0.0"]
