# --- App ---
ENVIRONMENT=development
DEBUG=false

# --- Security ---
SECRET_KEY=change_this_to_32_chars_min_random_string_xxxxxx
TOTP_SECRET_ENCRYPTION_KEY=another_32_chars_min_random_key_yyyyy

# --- Database ---
# Runtime connection: least-privileged application role.
DATABASE_URL=postgresql+psycopg://lar_app:lar_app_password@localhost:5432/lar_agro_centinel
# Migration connection: schema owner, used by Alembic only.
DATABASE_MIGRATION_URL=postgresql+psycopg://lar_owner:lar_owner_password@localhost:5432/lar_agro_centinel

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Sentinel Hub (for NDVI, optional in dev) ---
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
