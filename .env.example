# --- App ---
ENVIRONMENT=development
DEBUG=false

# --- Security ---
SECRET_KEY=change_this_to_32_chars_min_random_string_xxxxxx
TOTP_SECRET_ENCRYPTION_KEY=another_32_chars_min_random_key_yyyyy

# --- Database ---
# Runtime connection: least-privileged application role.
DATABASE_URL=postgresql+psycopg://lar_app:lar_app_password@localhost:5432/lar_agro_centinel
# Migration connection: schema owner, used by Alembic only.
DATABASE_MIGRATION_URL=postgresql+psycopg://lar_owner:lar_owner_password@localhost:5432/lar_agro_centinel

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Sentinel Hub / Copernicus Data Space (optional) ---
# Without credentials the app starts and satellite analysis answers 503.
# Tests never use them, even when set here (see backend/tests/conftest.py).
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
# Hard monthly cap on Processing Units; requests beyond it are refused.
SENTINEL_MONTHLY_PU_BUDGET=30000
# A queued analysis that never started expires after this many seconds
# (lost job); it must not be shorter than ANALYSIS_JOB_TIMEOUT_S (900).
ANALYSIS_PENDING_TIMEOUT_S=3600

# --- Raster storage ---
# "local" is not fit for production on ephemeral filesystems (KL-005).
# "s3" requires STORAGE_S3_BUCKET and STORAGE_S3_REGION, or the app won't start.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/rasters

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
