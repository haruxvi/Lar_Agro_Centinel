# Normalize line endings to LF so files mounted into Linux containers and CI
# runners behave the same as on Windows workstations.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.tif binary
*.tiff binary
*.pdf binary
*.woff binary
*.woff2 binary
